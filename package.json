{
	"name": "graphql-query-complexity-esm",
	"version": "3.0.0",
	"description": "GraphQL query complexity analysis validation rule with estimator chains, directive support, and iterative engine",
	"author": "Lafitte Mehdy (https://github.com/lafittemehdy)",
	"license": "MIT",
	"packageManager": "pnpm@12.14.0",
	"type": "module",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			},
			"default": "./dist/index.js"
		}
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"engines": {
		"node": ">=22.18.0"
	},
	"keywords": [
		"complexity-analysis",
		"dos-protection",
		"esm",
		"graphql",
		"graphql-security",
		"query-complexity",
		"security",
		"validation"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/lafittemehdy/graphql-query-complexity-esm.git"
	},
	"bugs": {
		"url": "https://github.com/lafittemehdy/graphql-query-complexity-esm/issues"
	},
	"homepage": "https://github.com/lafittemehdy/graphql-query-complexity-esm#readme",
	"sideEffects": false,
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"peerDependencies": {
		"graphql": "^16.0.0 || ^17.0.0"
	},
	"devDependencies": {
		"@apollo/server": "^5.5.1",
		"@biomejs/biome": "^2.5.15",
		"@graphql-tools/schema": "^11.0.2",
		"@types/node": "^26.6.5",
		"@vitest/coverage-v8": "^5.0.5",
		"@vitest/ui": "^5.0.5",
		"graphql": "^16.14.2",
		"graphql-yoga": "^5.24.6",
		"husky": "^9.1.7",
		"tsup": "^9.0.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vitest": "^5.0.5"
	},
	"scripts": {
		"bench": "tsx scripts/benchmark.ts",
		"bench:check": "tsx scripts/benchmark-check.ts",
		"bench:json": "tsx scripts/benchmark.ts --json",
		"build": "tsup",
		"check:workflow": "node scripts/check-pnpm-setup.mjs",
		"dev": "tsc --watch",
		"example:apollo": "tsx examples/servers/apollo-server.ts",
		"example:yoga": "tsx examples/servers/yoga-server.ts",
		"lint": "biome check && tsc --noEmit && pnpm run check:workflow",
		"lint:fix": "biome check --write && tsc --noEmit",
		"prepare": "husky",
		"prepublishOnly": "pnpm run lint && pnpm run build && pnpm test",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:ui": "vitest --ui",
		"test:watch": "vitest",
		"check:consumers": "tsc --noEmit --project tsconfig.consumers.json"
	}
}
